FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium xvfb x11vnc novnc websockify socat ca-certificates fonts-liberation && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /data/google-flights-profile
COPY scripts/google_browser.sh /usr/local/bin/google_browser.sh
RUN chmod +x /usr/local/bin/google_browser.sh
EXPOSE 6080 9222
ENTRYPOINT ["/usr/local/bin/google_browser.sh"]
