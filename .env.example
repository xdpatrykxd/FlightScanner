WAHA_API_KEY=replace-with-your-waha-api-key
WAHA_IMAGE=devlikeapro/waha:noweb-arm
WAHA_URL=http://whatsapp-gateway:3000
WHATSAPP_SESSION=default
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3010
WHATSAPP_GATEWAY_PORT=3010
WHATSAPP_GATEWAY_TIMEOUT_SECONDS=60
WHATSAPP_GATEWAY_ENGINE=GOWS
DATABASE_PATH=data/listings.sqlite3
CHECK_INTERVAL_MINUTES=180
REQUEST_TIMEOUT_SECONDS=60
REQUEST_CONCURRENCY=1
FILTERS_PATH=config/filters.yaml
# Optional: one or more international phone numbers or WAHA group IDs.
# Add real values, for example +32470123456 or 123456789-123456789@g.us.
# WHATSAPP_RECIPIENT_1=
# WHATSAPP_RECIPIENT_2=
# WHATSAPP_GROUP_IDS=
# WHATSAPP_RECIPIENTS=
